        "class ConversationMemory:\n",
        "    \"\"\"\n",
        "    Short-term : last `keep_turns` turns, passed verbatim to the LLM.\n",
        "    Long-term  : rolling summary (facts, names, goals) rewritten by the LLM as old turns drop out.\n",
        "    Emotion    : recent vocal-tone trajectory.\n",
        "    \"\"\"\n",
        "    SYSTEM = (\"You are a warm, concise voice assistant. Your reply is spoken aloud: \"\n",
        "              \"1-3 short sentences, plain text, no lists, no emojis. \"\n",
        "              \"Use the conversation history and what you remember. \"\n",
        "              \"Adapt to the user's emotional tone without naming it unless it helps.\")\n",
        "\n",
        "    def __init__(self, keep_turns=4):\n",
        "        self.keep_turns = keep_turns\n",
        "        self.recent, self.summary, self.tones = [], \"\", []\n",
        "\n",
        "    def build_messages(self, user_text, tone):\n",
        "        sys = self.SYSTEM\n",
        "        if self.summary:\n",
        "            sys += f\"\\nWhat you remember from earlier: {self.summary}\"\n",
        "        if self.tones:\n",
        "            sys += f\"\\nUser's recent vocal tone: {' > '.join(self.tones[-4:])}. Now: {tone}.\"\n",
        "        return [{\"role\": \"system\", \"content\": sys}] + self.recent + [{\"role\": \"user\", \"content\": user_text}]\n",
        "\n",
        "    def add_turn(self, user_text, reply, tone):\n",
        "        self.recent += [{\"role\": \"user\", \"content\": user_text},\n",
        "                        {\"role\": \"assistant\", \"content\": reply}]\n",
        "        self.tones.append(tone)\n",
        "        if len(self.recent) > 2 * self.keep_turns:\n",
        "            self._compress()\n",
        "\n",
        "    def _compress(self):\n",
        "        old, self.recent = self.recent[:4], self.recent[4:]\n",
        "        transcript = \"\\n\".join(f\"{m['role']}: {m['content']}\" for m in old)\n",
        "        prompt = [{\"role\": \"user\", \"content\":\n",
        "                   f\"Current memory: {self.summary or 'none'}\\n\\nNew conversation:\\n{transcript}\\n\\n\"\n",
        "                   \"Rewrite the memory to include facts, names, preferences, goals and unresolved topics. \"\n",
        "                   \"Max 80 words. Output only the memory.\"}]\n",
        "        self.summary = chat(prompt, max_new_tokens=120, temperature=0)\n",
        "\n",
        "    def save(self, path=\"memory.json\"):\n",
        "        json.dump(dict(recent=self.recent, summary=self.summary, tones=self.tones), open(path, \"w\"))\n",
        "\n",
        "    def load(self, path=\"memory.json\"):\n",
        "        if os.path.exists(path):\n",
        "            d = json.load(open(path))\n",
        "            self.recent, self.summary, self.tones = d[\"recent\"], d[\"summary\"], d[\"tones\"]\n",
        "\n",
        "memory = ConversationMemory()\n",
        "# memory.load(\"/content/drive/MyDrive/memory.json\")   # optional: persist across sessions (mount Drive first)"
